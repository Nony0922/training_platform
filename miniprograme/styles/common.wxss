/* ==========================================================================
   小程序公共样式
   ========================================================================== */

/* --------------------------------------------------------------------------
   页面基础
   -------------------------------------------------------------------------- */

page {
  background-color: #f5f3ff;
  color: #374151;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.empty {
  padding: 80rpx 0;
  color: #9ca3af;
  text-align: center;
}

/* --------------------------------------------------------------------------
   卡片
   -------------------------------------------------------------------------- */

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(124, 58, 237, 0.08);
}

.card-title {
  margin-bottom: 12rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 600;
}

.card-desc {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

/* --------------------------------------------------------------------------
   文本
   -------------------------------------------------------------------------- */

.label {
  color: #9ca3af;
}

.value {
  color: #374151;
}

.price {
  color: #7c3aed;
  font-size: 34rpx;
  font-weight: 700;
}

/* --------------------------------------------------------------------------
   按钮
   -------------------------------------------------------------------------- */

.btn-primary {
  border-radius: 12rpx;
  background: linear-gradient(135deg, #7c3aed, #6d28d9);
  color: #fff;
  font-size: 30rpx;
}

.btn-outline {
  border: 2rpx solid #7c3aed;
  border-radius: 12rpx;
  background: #fff;
  color: #7c3aed;
}

/* --------------------------------------------------------------------------
   标签
   -------------------------------------------------------------------------- */

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-purple {
  background: #ede9fe;
  color: #7c3aed;
}

.tag-green {
  background: #d1fae5;
  color: #065f46;
}

.tag-orange {
  background: #ffedd5;
  color: #c2410c;
}

.tag-gray {
  background: #f3f4f6;
  color: #6b7280;
}

.tag-red {
  background: #fee2e2;
  color: #b91c1c;
}
