/* ==========================================================================
   小程序公共样式 — 黄绿品牌色
   ========================================================================== */

page {
  background-color: #fafdf8;
  color: #374151;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.empty {
  padding: 80rpx 0;
  color: #9ca3af;
  text-align: center;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(46, 173, 106, 0.08);
  border: 1rpx solid rgba(184, 230, 206, 0.4);
}

.card-title {
  margin-bottom: 12rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 600;
}

.card-desc {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.label {
  color: #9ca3af;
}

.value {
  color: #374151;
}

.price {
  color: #e8b020;
  font-size: 34rpx;
  font-weight: 700;
}

.btn-primary {
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f5c842, #e8b020);
  color: #374151;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-outline {
  border: 2rpx solid #2ead6a;
  border-radius: 12rpx;
  background: #fff;
  color: #2ead6a;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-purple {
  background: #fff8e1;
  color: #c9a020;
}

.tag-green {
  background: #e8f8f0;
  color: #1f8f55;
}

.tag-orange {
  background: #ffedd5;
  color: #c2410c;
}

.tag-gray {
  background: #f3f4f6;
  color: #6b7280;
}

.tag-red {
  background: #fee2e2;
  color: #b91c1c;
}
