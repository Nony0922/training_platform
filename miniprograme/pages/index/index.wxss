@import '../../styles/common.wxss';

.welcome-card {
  background: linear-gradient(135deg, #f5c842, #2ead6a);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 173, 106, 0.25);
}
.welcome { display: block; font-size: 36rpx; font-weight: 600; }
.welcome-sub { display: block; font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #1f8f55; margin: 24rpx 0 16rpx; }
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.menu-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(46, 173, 106, 0.1);
  border: 1rpx solid rgba(184, 230, 206, 0.5);
  box-sizing: border-box;
}
.menu-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.menu-text { font-size: 22rpx; color: #4b5563; line-height: 1.3; }
